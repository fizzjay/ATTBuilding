<Project>
  <!-- MelonLoader.dll is AMD64. Both mod projects already set this, but
       Directory.Build.props is imported by every project built under this
       repo, so the MSIL-vs-AMD64 warning (MSB3270) stays gone even if a
       configuration/platform mapping drops the csproj PropertyGroup. -->
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Residual MSB3270 (MSIL vs AMD64 MelonLoader) is harmless for a
         MelonLoader mod -- the DLL is loaded as managed IL -- so don't
         print it on every build even if a solution platform mapping
         overrides PlatformTarget somewhere upstream. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>
</Project>
