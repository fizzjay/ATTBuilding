<?xml version="1.0" encoding="utf-8"?>
<!-- PC (Mono) build. Legacy project style, matching fizzjay/ArmorUpdate's
     pchost project: references resolve from the PC game's Managed folder /
     MelonLoader (add that folder to the reference search path, or copy the
     DLLs next to the project under ..\refs\pc -- gitignored). -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>ATTBuilding</RootNamespace>
    <AssemblyName>ATTBuilding</AssemblyName>
    <!-- MelonLoader.dll is AMD64: target x64 unconditionally, otherwise VS
         builds MSIL and warns MSB3270 (MSIL vs AMD64 mismatch). -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|Any CPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|Any CPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" />
    <Reference Include="Alta.Console" />
    <Reference Include="Alta.Serialization.Runtime" />
    <Reference Include="Alta.Singletons" />
    <Reference Include="Alta.Values" />
    <Reference Include="MelonLoader" />
    <!-- Needed only by the provided TabletUILib ServerMods.cs (server-mod bridge). -->
    <Reference Include="TavernLib" />
    <Reference Include="Root.Township" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\BuildState.cs"><Link>BuildState.cs</Link></Compile>
    <Compile Include="..\shared\CommandParser.cs"><Link>CommandParser.cs</Link></Compile>
    <Compile Include="..\shared\SnapMath.cs"><Link>SnapMath.cs</Link></Compile>
    <Compile Include="..\shared\TrackedRegistry.cs"><Link>TrackedRegistry.cs</Link></Compile>
    <Compile Include="..\shared\PrefabNicks.cs"><Link>PrefabNicks.cs</Link></Compile>
    <Compile Include="..\shared\VectorSnap.cs"><Link>VectorSnap.cs</Link></Compile>
    <Compile Include="Bubble.cs" />
    <Compile Include="BuildNet.cs" />
    <Compile Include="Builder.cs" />
    <!-- Provided TabletUILib (PC copy). TabletUIMod.cs (standalone TavernLib mod),
         Properties\AssemblyInfo.cs and the Microsoft/System compiler shims are
         excluded: Main does the wiring. -->
    <Compile Include="..\tabletpc\TabletUILib\BubbleAction.cs"><Link>TabletUILib\BubbleAction.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\BubbleEntry.cs"><Link>TabletUILib\BubbleEntry.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\Icons.cs"><Link>TabletUILib\Icons.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\Page.cs"><Link>TabletUILib\Page.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\Row.cs"><Link>TabletUILib\Row.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\ServerMods.cs"><Link>TabletUILib\ServerMods.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\TabletBubble.cs"><Link>TabletUILib\TabletBubble.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\TabletUI.cs"><Link>TabletUILib\TabletUI.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\TabletView.cs"><Link>TabletUILib\TabletView.cs</Link></Compile>
    <Compile Include="..\tabletpc\TabletUILib\TabletWheel.cs"><Link>TabletUILib\TabletWheel.cs</Link></Compile>
    <Compile Include="ConsoleHook.cs" />
    <Compile Include="Diag.cs" />
    <Compile Include="Main.cs" />
    <Compile Include="ServerCommands.cs" />
    <Compile Include="ServerSeam.cs" />
    <Compile Include="Spawner.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
