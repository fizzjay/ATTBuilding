<?xml version="1.0" encoding="utf-8"?>
<!-- PC (Mono) build. Legacy project style, matching fizzjay/ArmorUpdate's
     pchost project: references resolve from the PC game's Managed folder /
     MelonLoader (add that folder to the reference search path, or copy the
     DLLs next to the project under ..\refs\pc -- gitignored). -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>ATTBuilding</RootNamespace>
    <AssemblyName>ATTBuilding</AssemblyName>
    <!-- MelonLoader.dll is AMD64: target x64 unconditionally, otherwise VS
         builds MSIL and warns MSB3270 (MSIL vs AMD64 mismatch). -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|Any CPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|Any CPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" />
    <Reference Include="Alta.Console" />
    <Reference Include="Alta.Serialization.Runtime" />
    <Reference Include="Alta.Singletons" />
    <Reference Include="Alta.Values" />
    <Reference Include="MelonLoader" />
    <!-- TabletUILib-PC.dll (built against .NET Framework 4.8 -- hence this
         project's TargetFrameworkVersion v4.8; MSB3274 drops it otherwise).
         Resolves like the other references (game folder / refs\pc search
         path) and must ALSO be in the game's Mods folder: it patches and
         ticks itself via its own mod entrypoint. -->
    <Reference Include="TabletUILib-PC" />
    <Reference Include="Root.Township" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\BuildState.cs"><Link>BuildState.cs</Link></Compile>
    <Compile Include="..\shared\CommandParser.cs"><Link>CommandParser.cs</Link></Compile>
    <Compile Include="..\shared\SnapMath.cs"><Link>SnapMath.cs</Link></Compile>
    <Compile Include="..\shared\TrackedRegistry.cs"><Link>TrackedRegistry.cs</Link></Compile>
    <Compile Include="..\shared\PrefabNicks.cs"><Link>PrefabNicks.cs</Link></Compile>
    <Compile Include="..\shared\VectorSnap.cs"><Link>VectorSnap.cs</Link></Compile>
    <Compile Include="Bubble.cs" />
    <Compile Include="BuildNet.cs" />
    <Compile Include="Builder.cs" />
    <!-- TabletUILib is referenced as the prebuilt mod DLL (see below); the
         uploaded sources under ..\tabletpc stay as reference only. -->
    <Compile Include="ConsoleHook.cs" />
    <Compile Include="Diag.cs" />
    <Compile Include="Main.cs" />
    <Compile Include="ServerCommands.cs" />
    <Compile Include="ServerSeam.cs" />
    <Compile Include="Spawner.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
